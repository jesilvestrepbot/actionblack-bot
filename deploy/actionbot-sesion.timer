# Lanza la sesion de reserva cada 30 minutos (hora de Bogota). Cada corrida
# mira la proxima apertura del plan: si esta a menos de 40 min espera y
# dispara; si no, termina en segundos. Asi sirve para cualquier horario.
[Unit]
Description=Sesion de reserva Action Black cada 30 minutos

[Timer]
OnCalendar=*-*-* *:00,30:00 America/Bogota
Persistent=true

[Install]
WantedBy=timers.target
