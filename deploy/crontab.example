# Alternativa con cron: sesion cada 30 minutos (ajusta la ruta /opt/actionbot).
# Instalar con:  crontab deploy/crontab.example
# Cada corrida espera la proxima apertura si esta a menos de 40 min; si no,
# termina enseguida. flock evita dos sesiones a la vez.
CRON_TZ=America/Bogota
*/30 * * * * cd /opt/actionbot && flock -n /tmp/actionbot.lock .venv/bin/python -m actionbot sesion --max-espera-min 40 >> logs/cron.log 2>&1
