# Servicio de una sola ejecucion: reserva el proximo dia y se cierra.
# Lo dispara actionbot-sesion.timer. Modelo despertar-reservar-cerrar.
#   sudo cp deploy/actionbot-sesion.* /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now actionbot-sesion.timer
[Unit]
Description=Sesion de reserva Action Black (reserva el proximo dia y termina)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=actionbot
WorkingDirectory=/opt/actionbot
Environment=TZ=America/Bogota
EnvironmentFile=/opt/actionbot/.env
ExecStart=/opt/actionbot/.venv/bin/python -m actionbot sesion --max-espera-min 40
# Espera como maximo ~40 min a la apertura mas la rafaga.
TimeoutStartSec=90min
