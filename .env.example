# Copia este archivo como .env y completa tus credenciales de actionblack.co
ACTION_EMAIL=tu_correo@ejemplo.com
ACTION_PASSWORD=tu_contrasena

# Para avisos por correo (opcional). Misma convencion que el proyecto
# inversiones: GMAIL_USER + GMAIL_APP_PASSWORD. La contrasena es una
# CONTRASENA DE APLICACION de Gmail (no la normal):
# myaccount.google.com -> Seguridad -> Verificacion en 2 pasos ->
# Contrasenas de aplicaciones. Sirve la misma que usa inversiones si
# la tienes guardada, o crea una nueva en 2 minutos.
GMAIL_USER=jesilvestrep@gmail.com
GMAIL_APP_PASSWORD=
